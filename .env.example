# Copy to .env and fill in. Never commit .env.

# Postgres. The `exse` role and database are created manually once — see README.
#
# Two URLs because the host and the container reach Postgres differently:
# DATABASE_URL is used by `cargo run`, `cargo test` and `cargo sqlx prepare` on
# the host, where Postgres is a published port on localhost. DATABASE_URL_DOCKER
# is what compose passes into the container, where it resolves by service name
# over mz-net.
DATABASE_URL=postgres://exse:CHANGE_ME@127.0.0.1:5432/exse
DATABASE_URL_DOCKER=postgres://exse:CHANGE_ME@postgres:5432/exse

# Signs the session cookie. MUST be stable across restarts or the phone gets
# signed out on every deploy. Generate with:
#   openssl rand -hex 64
COOKIE_SECRET=CHANGE_ME

# Used only on first boot, when the users table is empty, to create `admin`.
# Change the password in Settings afterwards; the server warns until you do.
#
# This is NOT how you recover a forgotten password -- that is
# `make reset-password`, which changes the hash and touches nothing else.
ADMIN_INITIAL_PASSWORD=CHANGE_ME

# How long detailed per-exercise history is kept. Day-level "I exercised"
# records are never pruned regardless of this value.
RETENTION_DAYS=21

# How many exercises a day needs before it marks itself on the calendar. The
# daily band does not count towards it -- crunches and a plank are not a
# workout. Any day can still be marked or unmarked by hand from the calendar.
DAY_MIN_EXERCISES=4

PORT=3005
RUST_LOG=info,exse=debug
